{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipRecipe",
  "version": "0.1.0",
  "identifier": "com.xiaofany.cliprecipe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "剪方 ClipRecipe",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "publisher": "ClipRecipe contributors",
    "copyright": "Copyright (c) 2026 ClipRecipe contributors. MIT License.",
    "homepage": "https://github.com/seansongx/ClipRecipe",
    "category": "Video",
    "shortDescription": "开源的视频批量处理桌面工具",
    "longDescription": "剪方（ClipRecipe）是开源的视频批量处理桌面工具：把裁剪、调速、水印、字幕、拼接等处理组成配方，一次应用到整批视频，另有几十个独立的视频小工具。基于 Tauri 2 与 FFmpeg。",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NzUxMTIwRUI5MjBEMDEKUldRQkRaTHJJQkYxT2FhZzF3WnFkRVVDQlNKZlJzWlFFL0hUVFdpRlNzYysvUkd0b0RaZ0FpWmEK",
      "endpoints": [
        "https://xiaofany.com/api/update/cliprecipe/tauri/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/seansongx/ClipRecipe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
